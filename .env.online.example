# ONLINE MODE
APP_MODE=online
APP_TIMEZONE=Asia/Kolkata
SECRET_KEY=replace-with-a-long-random-secret
SUPER_ADMIN_USERNAME=superadmin
LEGACY_ADMIN_USERNAME=admin
# Existing deployments can keep ADMIN_PASSWORD unchanged.
ADMIN_PASSWORD=replace-with-the-existing-admin-password
# Optional: use a different password for the new Super Admin.
# SUPER_ADMIN_PASSWORD=replace-with-a-different-strong-password
DATABASE_URL=postgresql+psycopg://exam_user:replace-password@localhost:5432/examdb
PORT=8080
COOKIE_SECURE=1
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
# PostgreSQL pool limits are per Gunicorn worker.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300

# Optional. The public button always uses /download/offline on your own domain;
# this setting controls where that permanent route redirects.
OFFLINE_DOWNLOAD_URL=https://github.com/cshemant/HemantExamSystem/releases/download/v2.02/LearnWithHemant_Offline_Exam_V2.02_Windows.zip

# Staff/admin inactivity timeout
SESSION_TIMEOUT_MINUTES=45

# Enterprise security / live operations
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=10
LOGIN_LOCK_MINUTES=10
HEARTBEAT_STALE_SECONDS=45
MAX_ANSWER_LENGTH=4000
# Optional integration API. Use a random value of at least 24 characters.
# INTEGRATION_API_KEY=replace-with-a-long-random-api-key
# Hybrid Edge package encryption/authentication. Use the SAME high-entropy secret
# on the authorized central server and campus node; never send it with the package.
# EXAM_PACKAGE_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters

# Optional AI curriculum / question generation (V2.34 / V108)
# Choose one provider. The application never hard-codes a university syllabus.
AI_PROVIDER=none
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-with-openai-api-key
# OPENAI_MODEL=gpt-5-mini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=replace-with-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Student Code Editor queue API. Use a different token in every environment.
CODE_RUNNER_SHARED_TOKEN=replace-with-python-secrets-token-urlsafe-48-output
CODE_RUNNER_LEASE_SECONDS=120
CODE_EDITOR_MAX_SOURCE_BYTES=50000
CODE_EDITOR_MAX_STDIN_BYTES=10000
CODE_EDITOR_QUEUE_LIMIT=100
